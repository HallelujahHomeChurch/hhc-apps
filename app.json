{
  "expo": {
    "name": "HHC 教會",
    "slug": "hhc-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tw.org.alive.hhcapp"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "tw.org.alive.hhcapp",
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-router"
    ],
    "scheme": "hhc-app"
  }
}
