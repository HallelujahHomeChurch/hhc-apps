# Use an isolated test deployment; these public values are not secrets.
EXPO_PUBLIC_ACCOUNT_URL=https://account-test.alive.org.tw
EXPO_PUBLIC_API_URL=https://www-test.alive.org.tw
EXPO_PUBLIC_OAUTH_CLIENT_ID=hhc-app-test
# Set only after creating/choosing the authorized EAS test project.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Synthetic local preview only. Must be false for EAS/device builds.
EXPO_PUBLIC_DEMO=false
